{SECT 0 {SECT 0 {PARA 3 "" 0 "" {TEXT -1 43 "Trasformazione Isoterma -
 Moto Oscillatorio" }}{PARA 19 "" 0 "" {TEXT -1 21 "G.Piluso - Marzo 2
004" }}{PARA 0 "" 0 "" {TEXT -1 162 "Supponiamo di avere un cilindro e
d un pistone di massa \"m\". Supponendo la trasformazione isoterma, co
sa succede se lo sposto dalla sua posizione di equilibrio... " }}
{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 53 "restart:\nwith(plots):\nwith
(plottools):\nwith(DEtools):" }}}}{SECT 0 {PARA 3 "" 0 "" {TEXT -1 48 
"Equazione Differenziale e Condizioni al Contorno" }}{EXCHG {PARA 0 ">
 " 0 "" {MPLTEXT 1 0 55 "ode1:=m*diff(x(t),t$2)=-k/(h-x(t))-c*diff(x(t
),t)+Peso;" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 26 "ic1:=\{x(0)=2
.5,D(x)(0)=0\}:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 52 "sol1:=ds
olve(\{ode1\} union ic1, \{x(t)\},type=numeric):" }}}}{SECT 0 {PARA 3 
"" 0 "" {TEXT -1 4 "Dati" }}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 82 "
m:=1.0:\nk:=5:\nc:=0.2:\nh:=10.0:\ng:=9.81:\nPeso:=m*g:\nr:=0.5:\nA:=P
i*r^2:\nk:=Peso*h*A:" }}}}{SECT 0 {PARA 3 "" 0 "" {TEXT -1 7 "Grafico
